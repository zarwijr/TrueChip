library (secure_asic_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("secure_asic_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.1418;
    }
    pin("fifo_overflow_o") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("4.55009,4.55400,4.56391,4.58756,4.65321,4.86842,5.58139");
	}
	rise_transition(template_1) {
          values("0.02090,0.02369,0.03118,0.05515,0.14485,0.45854,1.50448");
	}
	cell_fall(template_1) {
          values("4.62836,4.63136,4.63932,4.65792,4.70337,4.83867,5.28784");
	}
	fall_transition(template_1) {
          values("0.01571,0.01787,0.02384,0.03918,0.08902,0.26563,0.86340");
	}
      }
    }
    pin("key_ready_o") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("5.12317,5.12777,5.13971,5.16648,5.23310,5.44721,6.16091");
	}
	rise_transition(template_1) {
          values("0.02709,0.03047,0.03866,0.06178,0.14686,0.45829,1.50243");
	}
	cell_fall(template_1) {
          values("5.02019,5.02355,5.03250,5.05274,5.09939,5.23464,5.68194");
	}
	fall_transition(template_1) {
          values("0.01976,0.02206,0.02809,0.04318,0.09061,0.26684,0.86344");
	}
      }
    }
    pin("locked_out_o") {
      direction : output;
      capacitance : 0.0017;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("5.52868,5.53296,5.54372,5.56838,5.63428,5.84909,6.56312");
	}
	rise_transition(template_1) {
          values("0.02346,0.02661,0.03419,0.05714,0.14526,0.45845,1.50163");
	}
	cell_fall(template_1) {
          values("5.05282,5.05583,5.06380,5.08244,5.12797,5.26332,5.71146");
	}
	fall_transition(template_1) {
          values("0.01556,0.01776,0.02354,0.03911,0.08886,0.26574,0.86358");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.90641");
	}
	fall_constraint(scalar) {
          values("-0.13798");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.22588");
	}
	fall_constraint(scalar) {
          values("0.69061");
	}
      }
    }
    pin("uart_rx_i") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.13000");
	}
	fall_constraint(scalar) {
          values("1.15014");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-1.11724");
	}
	fall_constraint(scalar) {
          values("-1.11893");
	}
      }
    }
    pin("uart_tx_o") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("4.67479,4.67920,4.68949,4.71484,4.78820,5.01414,5.70281");
	}
	rise_transition(template_1) {
          values("0.01624,0.01960,0.02910,0.06066,0.16607,0.49683,1.50967");
	}
	cell_fall(template_1) {
          values("4.16156,4.16494,4.17292,4.18981,4.22804,4.33284,4.65275");
	}
	fall_transition(template_1) {
          values("0.01303,0.01541,0.02114,0.03538,0.07670,0.21224,0.64224");
	}
      }
    }
  }

}
